# ============ 大模型配置（国内大模型，OpenAI 兼容接口） ============
# 说明：不配置 LLM_API_KEY 时系统进入「离线演示模式」，
#       使用确定性模板回答，可完整跑通 检索→引用→评测 全流程。
# DeepSeek 示例：
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# 通义千问（DashScope OpenAI 兼容模式）示例：
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
LLM_TEMPERATURE=0.2

# ============ 检索 ============
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
TOP_K=12
# 多轮对话保留最近 N 轮（追问支持）
HISTORY_TURNS=3

# ============ 服务（可选，本地运行一般无需设置） ============
# API 服务端口（FastAPI / Swagger 文档）
# API_PORT=8000
# Gradio 前端端口
# UI_PORT=7860
# 向量索引根目录（版本化，默认 D:/medsafe_index；Docker 部署设为 /app/index）
# INDEX_ROOT=D:/medsafe_index
# 旧链路回退索引目录（默认 D:/chroma_db；Docker 部署设为 /app/index）
# CHROMA_DIR=D:/chroma_db
