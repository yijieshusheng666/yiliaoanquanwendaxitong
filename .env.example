# ============ 大模型配置（国内大模型，OpenAI 兼容接口） ============
# 说明：不配置 LLM_API_KEY 时系统进入「离线演示模式」，
#       使用确定性模板回答，可完整跑通 检索→引用→评测 全流程。
# DeepSeek 示例：
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# 通义千问（DashScope OpenAI 兼容模式）示例：
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
LLM_TEMPERATURE=0.2

# ============ 检索 ============
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
TOP_K=12
# CrossEncoder 重排：1 开启（需先 python scripts/download_reranker.py 下载模型）
# RERANK_ENABLED=1
# 多轮对话保留最近 N 轮（追问支持）
HISTORY_TURNS=3

# ============ 服务（可选，本地运行一般无需设置） ============
# API 服务端口（FastAPI / Swagger 文档）
# API_PORT=8000
# Gradio 前端端口
# UI_PORT=7860
# 向量索引根目录（必须纯 ASCII；默认 D:/medsafe_index，Docker 部署设为 /app/index）
# 版本化索引落在 {INDEX_ROOT}/chroma_v{n}；CHROMA_DIR 是 MANIFEST 缺失时的回退目录，
# 两者默认同源（任一变量设置即对二者生效），避免回退到另一个陈旧索引。
# INDEX_ROOT=D:/medsafe_index
# CHROMA_DIR=D:/medsafe_index
