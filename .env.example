# ============ 大模型配置（国内大模型，OpenAI 兼容接口） ============
# 说明：不配置 LLM_API_KEY 时系统进入「离线演示模式」，
#       使用确定性模板回答，可完整跑通 检索→引用→评测 全流程。
# DeepSeek 示例：
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# 通义千问（DashScope OpenAI 兼容模式）示例：
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
LLM_TEMPERATURE=0.2

# ============ 检索 ============
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
TOP_K=12
# 多轮对话保留最近 N 轮（追问支持）
HISTORY_TURNS=3
